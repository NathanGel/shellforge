    "84.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"It appears that {APPNAME} crashed the last time it was used. Do you want to send a crash log to the developers?\\n\\nCrash logs from Apple are not sent to other developers, so this is the only way the developers of {APPNAME} can find out about and fix this crash.\"; ObjectID = \"84\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It appears that {APPNAME} crashed the last time it was used. Do you want to report it?"
          }
        }
      }
    },
    "85.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"You can delete any information you do not want transmitted, but this will make it more difficult to detect the bug. By default, the crash log as well as what Mac you are using and your settings are transmitted.\"; ObjectID = \"85\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy and Report… copies everything below and opens Shellforge’s bug form on GitHub, where you paste it. Nothing is sent by itself. GitHub issues are public: delete anything you do not want to share, such as your name, email address or settings."
          }
        }
      }
    },
    "86.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Send\"; ObjectID = \"86\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy and Report…"
          }
        }
      }
    },
