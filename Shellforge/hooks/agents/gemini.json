{
  "id": "gemini",
  "name": "Gemini CLI",
  "command": "gemini",
  "arguments": [
    [
      "-i",
      "{prompt}"
    ]
  ],
  "prompt": "argument",
  "models": {
    "fixed": {
      "_0": []
    }
  },
  "reasoningLevels": [],
  "environment": {},
  "secrets": {},
  "status": {
    "eventProtocol": {}
  },
  "statusSetup": {
    "file": "~/.gemini/settings.json",
    "snippet": "{\n  \"hooks\": {\n    \"BeforeAgent\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"{shellforge-status} working\"\n          }\n        ]\n      }\n    ],\n    \"AfterTool\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"{shellforge-status} working\"\n          }\n        ]\n      }\n    ],\n    \"Notification\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"{shellforge-status} needs-input\"\n          }\n        ]\n      }\n    ],\n    \"AfterAgent\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"{shellforge-status} done\"\n          }\n        ]\n      }\n    ]\n  }\n}"
  },
  "x-sources": [
    "https://geminicli.com/docs/cli/cli-reference/",
    "https://geminicli.com/docs/hooks/",
    "https://geminicli.com/docs/hooks/reference/"
  ],
  "x-description": "Google’s Gemini CLI. Some unpaid-tier and Google One users have moved to Antigravity CLI (per the Gemini CLI docs), so this command may not apply to them.",
  "x-statusSetupNote": "Merge the hooks into the existing “hooks” key of ~/.gemini/settings.json; do not replace the file or the key."
}
